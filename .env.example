# mcp-defectdojo configuration
# Copy to .env and fill in values before running.

# =============================================================================
# Required — DefectDojo connection
# =============================================================================

# Base URL of the DefectDojo instance (must use https:// unless overridden)
DEFECTDOJO_URL=https://defectdojo.example.com

# API key for DefectDojo (single-key mode)
# Generate at: DefectDojo > API v2 > Your API Key
DEFECTDOJO_API_KEY=

# =============================================================================
# Optional — Dual API key mode (overrides DEFECTDOJO_API_KEY)
# =============================================================================

# Separate read-only and write API keys for least-privilege access.
# When both are set, GET requests use the read key and POST/PATCH use the write key.
# DEFECTDOJO_READ_API_KEY=
# DEFECTDOJO_WRITE_API_KEY=

# =============================================================================
# Optional — MCP authentication
# =============================================================================

# Bearer token for MCP clients. When set, clients must include this token.
# Grants both read and write scopes.
# MCP_AUTH_TOKEN=

# Read-only bearer token. When set alongside MCP_AUTH_TOKEN, this token
# grants only read scope (list_*/get_* tools).
# MCP_READ_TOKEN=

# =============================================================================
# Optional — Transport
# =============================================================================

# Transport mode: stdio (default), sse, streamable-http, http
# FASTMCP_TRANSPORT=stdio

# Bind address and port for network transports (sse/http)
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8000

# =============================================================================
# Optional — Security
# =============================================================================

# Allow http:// URLs (default: false, TLS required)
# ALLOW_INSECURE_HTTP=false

# Mutation rate limit: max mutations per window (default: 60 per 60s)
# MUTATION_RATE_LIMIT=60
# MUTATION_RATE_WINDOW=60

# =============================================================================
# Optional — Logging and Audit
# =============================================================================

# Log level: DEBUG, INFO (default), WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO

# HMAC key for audit log integrity chain. REQUIRED for cross-restart
# log verification. Without this, an ephemeral key is generated per session.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# AUDIT_HMAC_KEY=

# Path for dedicated audit log file (JSON-lines format, logrotate-compatible).
# When unset, audit logs go to stderr only.
# AUDIT_LOG_FILE=/var/log/mcp-defectdojo/audit.log

# =============================================================================
# Optional — SIEM Log Forwarding
# =============================================================================

# Syslog forwarding (RFC 5424 framing).
# Format: [transport://]host[:port]
# Transports: tcp, udp, tcp+tls (default). Bare hostname defaults to tcp+tls.
# Default port: 6514 (TLS), 514 (TCP/UDP).
# AUDIT_LOG_SYSLOG=tcp+tls://syslog.example.com:6514

# Custom CA certificate for syslog TLS verification.
# AUDIT_LOG_SYSLOG_CA=

# HTTPS log forwarding (JSON array POST with batching).
# Works with Splunk HEC, Elasticsearch, Datadog, Loki, or any HTTPS webhook.
# AUDIT_LOG_HTTPS_URL=https://splunk-hec.example.com:8088/services/collector

# Bearer token for HTTPS endpoint authentication (e.g., Splunk HEC token).
# AUDIT_LOG_HTTPS_TOKEN=

# Batch size and flush interval for HTTPS forwarding.
# AUDIT_LOG_HTTPS_BATCH_SIZE=10
# AUDIT_LOG_HTTPS_FLUSH_SECS=5

